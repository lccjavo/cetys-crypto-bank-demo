# Copiar a .env (ya está en .gitignore, no se sube al repo) y compartir el
# valor real por un canal fuera de git (chat privado, gestor de secretos, etc).

# AES-256-GCM whole-file demo (03-encrypt-db.mjs / 04-decrypt-db.mjs / 11-tamper-ciphertext.mjs)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DB_SQLite_TEST_KEY=

# Passphrase de bank-cipher.db (SQLCipher v4 real, vía better-sqlite3-multiple-ciphers)
# Generar con: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
SQLCIPHER_PASSPHRASE=
